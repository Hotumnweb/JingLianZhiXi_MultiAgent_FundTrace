# ============================================================
# 配置模板：复制为 .env 后按本机情况修改
#   Windows PowerShell: Copy-Item .env.example .env
# ============================================================

# ---------- Neo4j（图数据工具：IP + 端口） ----------
# 本机回环地址（Node3 未上线前的开发回退）；
# Node3 就绪后改为该节点 IP，例如 192.168.0.201（监听 0.0.0.0:7687，防火墙只放行 Node1）
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=改成你的Neo4j密码
# 可选：NEO4J_SCHEME=bolt（默认；TLS 用 bolt+s / neo4j+s）
# 可选：NEO4J_DATABASE=neo4j（不填用服务端默认库）
# 可选：NEO4J_CONNECTION_TIMEOUT=5（建立连接超时，秒）
# 旧写法仍兼容（优先级低于上面的 IP/端口），需要时取消下一行注释：
# NEO4J_URI=bolt://localhost:7687

# ---------- 大模型（Ollama） ----------
# 本地 CPU 调试（模型名以 `ollama list` 为准）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# 第二台 GPU 节点（示例：Qwen3.5-9B-tools，需关闭 thinking）
# OLLAMA_BASE_URL=http://192.168.0.200:11434
# OLLAMA_MODEL=qwen3.5-9b-tools:q4km

# ---------- 推理参数 ----------
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1400
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_KEEP_ALIVE=5m
# Qwen3.5 等思考模型必须关闭 thinking，否则 content 可能为空
# LLM_THINK=false

# ---------- 报告节点开关 ----------
ENABLE_REPORT_AGENT=0

# ---------- 平台展示用节点规划（三机部署时使用） ----------
# 当前联调网段：Node1 192.168.0.199 / Node2 192.168.0.200 / Node3 规划 192.168.0.201
# Node2：GPU 算力中心（Qwen3.5-9B-tools + Ollama）
# Node3：工具与图数据节点（Neo4j + pandas 解析），Node3 上线前暂由本机承担
# 注意：Node3 的实际连接地址看上面的 NEO4J_HOST / NEO4J_PORT，这里只做拓扑展示。
NODE2_TARGET_IP=192.168.0.200
NODE3_TARGET_IP=192.168.0.201
