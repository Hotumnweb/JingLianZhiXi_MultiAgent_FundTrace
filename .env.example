# ============================================================
# 配置模板：复制为 .env 后按本机情况修改
#   Windows PowerShell: Copy-Item .env.example .env
# ============================================================

# ---------- Neo4j（第一台电脑本机） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=改成你的Neo4j密码

# ---------- 大模型（Ollama） ----------
# 本地 CPU 调试（模型名以 `ollama list` 为准）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# 第二台 GPU 节点（模型名以第二台 `ollama list` 为准）
# OLLAMA_BASE_URL=http://192.168.50.2:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---------- 推理参数 ----------
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1400
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_KEEP_ALIVE=5m

# ---------- 报告节点开关 ----------
ENABLE_REPORT_AGENT=0

# ---------- 平台展示用节点规划（四机部署时使用） ----------
NODE2_TARGET_IP=192.168.50.2
NODE3_TARGET_IP=192.168.50.3
NODE4_TARGET_IP=192.168.50.4
