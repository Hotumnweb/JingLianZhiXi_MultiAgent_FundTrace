# ============================================================
# 配置模板：复制为 .env 后按本机情况修改
#   Windows PowerShell: Copy-Item .env.example .env
# ============================================================

# ---------- Neo4j（第一台电脑本机） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=改成你的Neo4j密码

# ---------- 大模型（Ollama） ----------
# 本地 CPU 调试（模型名以 `ollama list` 为准）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# 第二台 GPU 节点（Qwen3-4B 微调 + Qwen-Agent + Ollama）
# OLLAMA_BASE_URL=http://192.168.50.2:11434
# OLLAMA_MODEL=qwen3-4b-instruct

# ---------- 推理参数 ----------
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1400
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_KEEP_ALIVE=5m

# ---------- 报告节点开关 ----------
ENABLE_REPORT_AGENT=0

# ---------- 平台展示用节点规划（三机部署时使用） ----------
# Node2：GPU 算力中心（Qwen3-4B 微调 + Qwen-Agent + Ollama），当前占位
# Node3：工具与图数据节点（Neo4j + pandas 解析）
NODE2_TARGET_IP=192.168.50.2
NODE3_TARGET_IP=192.168.50.3
